{
  "name": "@stableops/playground",
  "version": "1.3.1",
  "private": true,
  "description": "Public React examples for StableOps sandbox payments, hosted checkout, and subscriptions.",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "stableops",
    "playground",
    "react",
    "stablecoin",
    "usdc",
    "usdt",
    "payment",
    "web3"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StableOps/stableops-playground.git"
  },
  "homepage": "https://stableops.dev",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build:example": "vite build",
    "preview": "vite preview",
    "build": "rm -rf dist && tsc",
    "i18n": "typesafe-i18n --no-watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stableops/api-sdk": "^1.1.0",
    "@stableops/wallet-ui": "^1.0.0",
    "@stableops/wallet-sdk": "^1.0.2",
    "@walletconnect/universal-provider": "2.23.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^2.6.0",
    "typesafe-i18n": "^5.27.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@solana/web3.js": "^1.98.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.16.0",
    "globals": "^15.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.18.0",
    "tronweb": "^6.0.0",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  }
}
